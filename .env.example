# MongoDB (current live store — used until the Mongo→Postgres cutover, #24/#25)
MONGODB_URI=mongodb://localhost:27017/social-media-auto-posting

# Postgres (migration target — Drizzle schema in db/schema.ts, #21).
# Hosted: Neon connection string. Self-host: bundled postgres.
DATABASE_URL=postgres://user:password@localhost:5432/autopost

# Mongo→Postgres cutover routing (lib/db/dual-write.ts, #25 — see docs/cutover.md).
# DB_WRITE: mongo | postgres | both   DB_READ: mongo | postgres   (defaults: mongo)
DB_WRITE=mongo
DB_READ=mongo

# NextAuth Drizzle/Postgres adapter (#26). Unset = JWT + Mongo user upsert
# (current). Set to `drizzle` ONLY in staging during the cutover; sessions stay JWT.
# AUTH_ADAPTER=drizzle

# GitHub Packages token for the @poukai-inc npm registry (.npmrc resolves
# ${NPM_TOKEN} at install time). Needs read:packages scope only.
# SECURITY: never commit a real token. .env is gitignored and excluded from the
# Docker build context (.dockerignore) — keep it that way. In CI use a repo
# secret; for local dev export a shell PAT. If a token is ever exposed, rotate
# it immediately at https://github.com/settings/tokens.
NPM_TOKEN=your-github-read-packages-pat

# NextAuth
AUTH_SECRET=your-auth-secret-generate-with-openssl-rand-base64-32
# Used by lib/oauth-state.ts for HMAC-signing OAuth state params. Set it equal
# to AUTH_SECRET (same value) unless you intentionally rotate them separately.
NEXTAUTH_SECRET=your-auth-secret-generate-with-openssl-rand-base64-32

# pouk-auth SSO (OIDC identity provider — ADR-0008). Login still works without
# these set; the pouk provider is only registered when POUK_CLIENT_ID is present.
POUK_ISSUER=https://id.pouk.ai
POUK_CLIENT_ID=
POUK_CLIENT_SECRET=

# LinkedIn OAuth
# Create your app at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# OpenAI API Key (for AI content generation)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# AI Provider Configuration
# AI_PROVIDER=ollama or groq (default: ollama)
AI_PROVIDER=ollama
# Ollama local LLM server
OLLAMA_BASE_URL=http://192.168.1.9:11434
OLLAMA_MODEL=qwen2.5:7b
# Groq cloud (only needed if AI_PROVIDER=groq)
# GROQ_API_KEY=your-groq-key

# Cron Secret (for securing the scheduler endpoint)
CRON_SECRET=your-cron-secret-key

# App URL
NEXTAUTH_URL=http://localhost:3000

# MINIO

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=uploads

# Encryption key for data-source connection strings at rest (review H5).
# 32 bytes, hex (64 chars) or base64. If unset, connection strings are stored
# as plaintext (legacy behavior) — set this in production.
# Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# Set to "true" to allow user data-source connections to private/loopback hosts
# (local dev only). Unset/false blocks them as an SSRF guard (review C7).
ALLOW_PRIVATE_DATA_SOURCES=

# Optional: comma-separated admin emails allowed to read /api/ai/usage telemetry
# (review C4). If unset, any authenticated user may read it.
ADMIN_EMAILS=

# Optional: set "true" to expose /api/engagements/debug in production (review L3).
ENABLE_DEBUG_ENDPOINTS=