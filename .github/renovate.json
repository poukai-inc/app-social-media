{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "America/Chicago",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies", "renovate"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "@poukai-inc/* — design-system + internal libraries; PR immediately, label, never auto-merge majors",
      "matchPackagePatterns": ["^@poukai-inc/"],
      "groupName": "poukai-inc internal packages",
      "labels": ["design-system", "dependencies"],
      "schedule": ["at any time"],
      "prCreation": "immediate",
      "automerge": false,
      "rangeStrategy": "pin",
      "commitMessagePrefix": "chore(deps): "
    },
    {
      "description": "Next.js — security patches only, auto-merge patch, manual review for minor+",
      "matchPackageNames": ["next", "eslint-config-next"],
      "groupName": "next.js",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "next-auth — exact-pinned beta per BACKLOG #119; require manual review for ANY bump",
      "matchPackageNames": ["next-auth"],
      "labels": ["security", "manual-review"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Type-only dev deps — group + auto-merge minor/patch",
      "matchPackagePatterns": ["^@types/"],
      "groupName": "type definitions",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Lockfile maintenance",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "schedule": ["before 6am on the first day of the month"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "prCreation": "immediate"
  },
  "hostRules": [
    {
      "description": "GitHub Packages npm registry — token configured in Renovate app/Mend dashboard as NPM_TOKEN",
      "matchHost": "npm.pkg.github.com",
      "hostType": "npm"
    }
  ]
}
